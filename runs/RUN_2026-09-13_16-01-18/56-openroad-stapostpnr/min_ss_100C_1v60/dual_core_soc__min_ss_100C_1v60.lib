library (dual_core_soc) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00147,  0.00431,  0.01267,  0.03723,  0.10935,  0.32121");
  }

  cell ("dual_core_soc") {
    area : 824277.375 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0889;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("1.46836");
	}
	cell_fall(scalar) {
          values("1.30387");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("1.98504");
	}
	cell_fall(scalar) {
          values("1.75125");
	}
      }
    }
    pin("reset") {
      direction : input;
      capacitance : 0.0398;
    }
    pin("uart_rx_line") {
      direction : input;
      capacitance : 0.0049;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.44386");
	}
	fall_constraint(scalar) {
          values("0.30847");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.37078");
	}
	fall_constraint(scalar) {
          values("-0.12361");
	}
      }
    }
    pin("uart_tx_line") {
      direction : output;
      capacitance : 0.0030;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00147,  0.00431,  0.01267,  0.03723,  0.10935,  0.32121");
          values("3.45538,3.46864,3.50323,3.59764,3.86882,4.66984,7.00204");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00147,  0.00431,  0.01267,  0.03723,  0.10935,  0.32121");
          values("0.04243,0.05657,0.09826,0.22525,0.60430,1.72550,4.99688");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00147,  0.00431,  0.01267,  0.03723,  0.10935,  0.32121");
          values("3.30584,3.32118,3.35793,3.44559,3.67948,4.36441,6.36776");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00147,  0.00431,  0.01267,  0.03723,  0.10935,  0.32121");
          values("0.04798,0.06091,0.09550,0.19555,0.50158,1.42366,4.10269");
	}
      }
    }
  }

}
