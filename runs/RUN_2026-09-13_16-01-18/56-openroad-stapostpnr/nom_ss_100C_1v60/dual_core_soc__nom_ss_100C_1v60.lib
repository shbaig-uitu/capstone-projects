library (dual_core_soc) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00147,  0.00431,  0.01267,  0.03723,  0.10935,  0.32121");
  }

  cell ("dual_core_soc") {
    area : 824277.375 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0959;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("1.54416");
	}
	cell_fall(scalar) {
          values("1.36282");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("2.08708");
	}
	cell_fall(scalar) {
          values("1.82982");
	}
      }
    }
    pin("reset") {
      direction : input;
      capacitance : 0.0428;
    }
    pin("uart_rx_line") {
      direction : input;
      capacitance : 0.0051;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.44776");
	}
	fall_constraint(scalar) {
          values("0.33841");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.37441");
	}
	fall_constraint(scalar) {
          values("-0.15361");
	}
      }
    }
    pin("uart_tx_line") {
      direction : output;
      capacitance : 0.0033;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00147,  0.00431,  0.01267,  0.03723,  0.10935,  0.32121");
          values("3.55532,3.56858,3.60318,3.69758,3.96877,4.77031,7.10091");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00147,  0.00431,  0.01267,  0.03723,  0.10935,  0.32121");
          values("0.04243,0.05658,0.09826,0.22527,0.60437,1.72576,4.99630");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00147,  0.00431,  0.01267,  0.03723,  0.10935,  0.32121");
          values("3.39922,3.41457,3.45129,3.53897,3.77285,4.45775,6.46110");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00147,  0.00431,  0.01267,  0.03723,  0.10935,  0.32121");
          values("0.04797,0.06091,0.09552,0.19554,0.50158,1.42414,4.10343");
	}
      }
    }
  }

}
