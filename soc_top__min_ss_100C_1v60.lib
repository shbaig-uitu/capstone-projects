library (soc_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00147,  0.00431,  0.01267,  0.03723,  0.10935,  0.32121");
  }
  type ("led") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("soc_top") {
    area : 3823.654 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0142;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.43526");
	}
	cell_fall(scalar) {
          values("0.49073");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.44177");
	}
	cell_fall(scalar) {
          values("0.49655");
	}
      }
    }
    pin("mbox_c0_to_c1_flag") {
      direction : output;
      capacitance : 0.0008;
    }
    pin("mbox_c1_to_c0_flag") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0033;
    }
    pin("uart_tx") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00147,  0.00431,  0.01267,  0.03723,  0.10935,  0.32121");
          values("2.00751,2.02078,2.05540,2.14973,2.42095,3.21799,5.56061");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00147,  0.00431,  0.01267,  0.03723,  0.10935,  0.32121");
          values("0.04244,0.05655,0.09830,0.22506,0.60382,1.72388,4.99882");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00147,  0.00431,  0.01267,  0.03723,  0.10935,  0.32121");
          values("1.56341,1.57873,1.61516,1.70307,1.93689,2.61883,4.62027");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00147,  0.00431,  0.01267,  0.03723,  0.10935,  0.32121");
          values("0.04768,0.06094,0.09591,0.19543,0.50218,1.42536,4.10573");
	}
      }
    }
    bus("led") {
      bus_type : led;
      direction : output;
      capacitance : 0.0000;
    pin("led[7]") {
      direction : output;
      capacitance : 0.0008;
    }
    pin("led[6]") {
      direction : output;
      capacitance : 0.0008;
    }
    pin("led[5]") {
      direction : output;
      capacitance : 0.0007;
    }
    pin("led[4]") {
      direction : output;
      capacitance : 0.0008;
    }
    pin("led[3]") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("led[2]") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("led[1]") {
      direction : output;
      capacitance : 0.0012;
    }
    pin("led[0]") {
      direction : output;
      capacitance : 0.0012;
    }
    }
  }

}
