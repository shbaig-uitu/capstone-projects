
module processing_element (
    input  logic clk,
    input  logic rst,

    input  logic signed [7:0] a_in,
    input  logic signed [7:0] b_in,

    output logic signed [31:0] acc_out
);

always_ff @(posedge clk) begin
    if (rst)
        acc_out <= 32'd0;
    else
        acc_out <= acc_out + (a_in * b_in);
end

endmodule

