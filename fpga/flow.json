{
  "project_name": "RISC-V SoC with Virtual Memory Support - FPGA Implementation",
  "project_description": "Complete FPGA implementation of RISC-V SoC with MMU/TLB and virtual memory support on Digilent Arty A7-100T board",
  "version": "1.0",
  "target_device": {
    "device": "xc7a100tcsg324-1",
    "device_name": "Xilinx Artix-7 A7-100T",
    "package": "CSG324",
    "speed_grade": "-1",
    "board": "arty_a7-100",
    "board_name": "Digilent Arty A7-100T",
    "io_voltage": "3.3V",
    "logic_cells": 101440,
    "block_ram_kb": 4860,
    "dsp48_slices": 240
  },
  "design_sources": {
    "rtl_directory": "../rtl",
    "top_module": "riscv_soc_top",
    "verilog_version": "Verilog-2005",
    "rtl_files": [
      "../rtl/include/riscv_defines.sv",
      "../rtl/include/riscv_types.sv",
      "../rtl/core/rv32i_core.sv",
      "../rtl/mmu/mmu.sv",
      "../rtl/mmu/tlb.sv",
      "../rtl/peripheral/csr_unit.sv",
      "../rtl/peripheral/exception_handler.sv",
      "../rtl/memory/sram_sp.sv",
      "../rtl/top/riscv_soc_top.sv"
    ]
  },
  "constraint_files": {
    "primary": "arty100t.xdc",
    "type": "Vivado Design Constraints",
    "constraints": {
      "clock": {
        "frequency_mhz": 100,
        "pin": "E3",
        "iostandard": "LVCMOS33"
      },
      "reset": {
        "pin": "D9",
        "active_level": "low",
        "iostandard": "LVCMOS33"
      },
      "uart_interface": {
        "uart_rx": "A9",
        "uart_tx": "D10",
        "baud_rate": 115200,
        "iostandard": "LVCMOS33"
      },
      "gpio_outputs": {
        "led0": "H17",
        "led1": "K15",
        "led2": "J13",
        "led3": "N14",
        "extended_gpio": ["J5", "H5", "J4", "G6"]
      },
      "gpio_inputs": {
        "sw0": "C9",
        "sw1": "B9",
        "sw2": "B8",
        "sw3": "A8",
        "extended_gpio": ["H4", "G4", "F3", "H2"]
      }
    }
  },
  "build_flow": {
    "synthesis": {
      "tool": "Vivado Synthesis (vivado -synth)",
      "strategy": "default",
      "optimization": "area",
      "steps": [
        "Read RTL source files",
        "Process includes and macros",
        "Read constraints",
        "Synthesize design",
        "Generate checkpoint"
      ]
    },
    "implementation": {
      "tool": "Vivado P&R (vivado -impl)",
      "strategy": "default",
      "steps": [
        "Read synthesis checkpoint",
        "Optimize design",
        "Run place and route",
        "Physical optimization",
        "Generate checkpoint"
      ]
    },
    "bitstream": {
      "tool": "Vivado Bitstream Generation",
      "compression": true,
      "steps": [
        "Read implementation checkpoint",
        "Configure device",
        "Generate bitstream",
        "Generate debug probe file (LTX)"
      ]
    }
  },
  "build_targets": {
    "make_build": {
      "description": "Complete build flow (synthesis -> implementation -> bitstream)",
      "command": "make build",
      "outputs": ["bitstream/riscv_soc_arty.bit"]
    },
    "make_synth": {
      "description": "Synthesis only",
      "command": "make synth",
      "outputs": ["build/synth/riscv_soc_arty_synth.dcp"]
    },
    "make_impl": {
      "description": "Place & Route only (requires synth)",
      "command": "make impl",
      "outputs": ["build/impl/riscv_soc_arty_impl.dcp"]
    },
    "make_bitstream": {
      "description": "Generate bitstream (requires impl)",
      "command": "make bitstream",
      "outputs": ["bitstream/riscv_soc_arty.bit"]
    },
    "make_program": {
      "description": "Program FPGA with bitstream",
      "command": "make program",
      "prerequisites": ["bitstream/riscv_soc_arty.bit"],
      "board_connection": "required"
    }
  },
  "directory_structure": {
    "fpga_root": "./",
    "scripts": "./scripts",
    "build_output": "./build",
    "bitstream_output": "./bitstream",
    "reports": "./bitstream/reports",
    "rtl_source": "../rtl",
    "rtl_wrapper": "./rtl_wrapper"
  },
  "interfaces": {
    "clk": {
      "width": 1,
      "direction": "input",
      "frequency": "100 MHz",
      "description": "System clock"
    },
    "rst_n": {
      "width": 1,
      "direction": "input",
      "active_level": "low",
      "description": "Active-low reset"
    },
    "uart": {
      "uart_rx": {
        "direction": "input",
        "description": "UART receive (from USB-UART)"
      },
      "uart_tx": {
        "direction": "output",
        "description": "UART transmit (to USB-UART)"
      },
      "baud_rate": 115200
    },
    "gpio": {
      "gpio_in": {
        "width": 8,
        "direction": "input",
        "description": "GPIO inputs (switches)"
      },
      "gpio_out": {
        "width": 8,
        "direction": "output",
        "description": "GPIO outputs (LEDs)"
      }
    },
    "axi4_lite_debug": {
      "status": "available_internal",
      "description": "Future debug interface (not routed to board pins)",
      "note": "Can be routed to PMOD connectors in future revisions"
    },
    "external_interrupt": {
      "status": "mapped_to_reset",
      "description": "External interrupt (currently tied to reset)"
    }
  },
