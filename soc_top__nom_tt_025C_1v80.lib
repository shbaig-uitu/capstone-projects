library (soc_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 1.80;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00130,  0.00336,  0.00872,  0.02260,  0.05861,  0.15199");
  }
  type ("led") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("soc_top") {
    area : 3823.654 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0148;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.25082");
	}
	cell_fall(scalar) {
          values("0.28031");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.25529");
	}
	cell_fall(scalar) {
          values("0.28382");
	}
      }
    }
    pin("mbox_c0_to_c1_flag") {
      direction : output;
      capacitance : 0.0008;
    }
    pin("mbox_c1_to_c0_flag") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0034;
    }
    pin("uart_tx") {
      direction : output;
      capacitance : 0.0010;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00130,  0.00336,  0.00872,  0.02260,  0.05861,  0.15199");
          values("0.99234,0.99895,1.01448,1.05215,1.14743,1.39376,2.03448");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00130,  0.00336,  0.00872,  0.02260,  0.05861,  0.15199");
          values("0.02427,0.03158,0.05074,0.10182,0.23625,0.58819,1.50166");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00130,  0.00336,  0.00872,  0.02260,  0.05861,  0.15199");
          values("0.82814,0.83515,0.85050,0.88338,0.95851,1.14846,1.63963");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00130,  0.00336,  0.00872,  0.02260,  0.05861,  0.15199");
          values("0.02525,0.03086,0.04514,0.08010,0.17283,0.42638,1.07960");
	}
      }
    }
    bus("led") {
      bus_type : led;
      direction : output;
      capacitance : 0.0000;
    pin("led[7]") {
      direction : output;
      capacitance : 0.0008;
    }
    pin("led[6]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("led[5]") {
      direction : output;
      capacitance : 0.0008;
    }
    pin("led[4]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("led[3]") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("led[2]") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("led[1]") {
      direction : output;
      capacitance : 0.0012;
    }
    pin("led[0]") {
      direction : output;
      capacitance : 0.0013;
    }
    }
  }

}
