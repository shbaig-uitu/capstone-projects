library (soc_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 1.95;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00136,  0.00370,  0.01006,  0.02736,  0.07440,  0.20234");
  }
  type ("led") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("soc_top") {
    area : 3823.654 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0148;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.17443");
	}
	cell_fall(scalar) {
          values("0.19241");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.17795");
	}
	cell_fall(scalar) {
          values("0.19509");
	}
      }
    }
    pin("mbox_c0_to_c1_flag") {
      direction : output;
      capacitance : 0.0008;
    }
    pin("mbox_c1_to_c0_flag") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0035;
    }
    pin("uart_tx") {
      direction : output;
      capacitance : 0.0010;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00136,  0.00370,  0.01006,  0.02736,  0.07440,  0.20234");
          values("0.62667,0.63178,0.64451,0.67731,0.76545,1.00508,1.65717");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00136,  0.00370,  0.01006,  0.02736,  0.07440,  0.20234");
          values("0.01688,0.02274,0.03923,0.08525,0.21175,0.55924,1.50073");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00136,  0.00370,  0.01006,  0.02736,  0.07440,  0.20234");
          values("0.54206,0.54724,0.55894,0.58511,0.64921,0.82125,1.28910");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00136,  0.00370,  0.01006,  0.02736,  0.07440,  0.20234");
          values("0.01715,0.02154,0.03243,0.06099,0.14190,0.36644,0.99129");
	}
      }
    }
    bus("led") {
      bus_type : led;
      direction : output;
      capacitance : 0.0000;
    pin("led[7]") {
      direction : output;
      capacitance : 0.0008;
    }
    pin("led[6]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("led[5]") {
      direction : output;
      capacitance : 0.0008;
    }
    pin("led[4]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("led[3]") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("led[2]") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("led[1]") {
      direction : output;
      capacitance : 0.0012;
    }
    pin("led[0]") {
      direction : output;
      capacitance : 0.0013;
    }
    }
  }

}
