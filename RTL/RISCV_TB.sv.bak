`timescale 1ns / 1ps

module riscv_tb;
    logic clk;
    logic reset;

    // Core Wires
    wire [31:0] imem_addr;
    wire [31:0] imem_data;
    wire [31:0] mem_addr;
    wire [31:0] mem_wdata;
    wire        mem_read;
    wire        mem_write;
    reg  [31:0] mem_rdata;

    // Simulation Data RAM (256 Words)
    reg [31:0] dmem [0:255];

    // DUT (Device Under Test)
    riscv_top uut (
        .clk        (clk),
        .reset      (reset),
        .imem_addr  (imem_addr),
        .imem_data  (imem_data),
        .mem_addr   (mem_addr),
        .mem_wdata  (mem_wdata),
        .mem_read   (mem_read),
        .mem_write  (mem_write),
        .mem_rdata  (mem_rdata)
    );

    // Instruction Memory Instance
    instruction_memory imem_u (
        .pc   (imem_addr),
        .inst (imem_data)
    );

    // Clock Generation (10ns period -> 100MHz)
    always #5 clk = ~clk;

    // Data Memory Emulation (Word-aligned: mem_addr >> 2)
    always @(posedge clk) begin
        if (mem_write) begin
            dmem[mem_addr[9:2]] <= mem_wdata;
            $display("[MEM WRITE] Time=%0t | Addr=0x%08h | Data=%0d", $time, mem_addr, mem_wdata);
        end
    end

    always @(*) begin
        if (mem_read)
            mem_rdata = dmem[mem_addr[9:2]];
        else
            mem_rdata = 32'b0;
    end

    // Test Sequence
    initial begin
        clk = 0;
        reset = 0; // Assert Active-Low Reset
        #20;
        reset = 1; // Release Reset

        $display("-------------------------------------------------------------------");
        $display("Execution Started...");
        $display("-------------------------------------------------------------------");

        // Monitor Register values every time PC changes
        $monitor("Time=%0t | PC=0x%02h | x1=%0d | x2=%0d | x3=%0d | x4=%0d", 
                 $time, uut.pc, 
                 uut.rf_u.registers[1], 
                 uut.rf_u.registers[2], 
                 uut.rf_u.registers[3], 
                 uut.rf_u.registers[4]);

        // Total run time for binary program execution
        #150;

        $display("-------------------------------------------------------------------");
        $display("Final Register Check:");
        $display("x1 (Expected 10) = %0d", uut.rf_u.registers[1]);
        $display("x2 (Expected 20) = %0d", uut.rf_u.registers[2]);
        $display("x4 (Expected 30) = %0d", uut.rf_u.registers[4]);
        $display("x3 (Expected 30) = %0d", uut.rf_u.registers[3]);

        if (uut.rf_u.registers[4] == 32'd30 && uut.rf_u.registers[3] == 32'd30) begin
            $display(">> SUCCESS: Core Load/Store & Math Verified Successfully! <<");
        end else begin
            $display(">> ERROR: Simulation Failed! Output does not match expected values. <<");
        end
        $display("-------------------------------------------------------------------");

        $finish;
    end

endmodule
