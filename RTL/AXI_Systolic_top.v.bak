`timescale 1ns / 1ps
module axi_systolic_top #(
    parameter DATA_WIDTH = 8,
    parameter ACC_WIDTH  = 32
)(
    input  wire                  ACLK,
    input  wire                  ARESETN,

    // AXI4-Lite Slave Interface
    input  wire [31:0]           ARADDR,
    input  wire                  ARVALID,
    output reg                   ARREADY,
    output reg  [31:0]           RDATA,
    output wire [1:0]            RRESP,
    output reg                   RVALID,
    input  wire                  RREADY,

    input  wire [31:0]           AWADDR,
    input  wire                  AWVALID,
    output reg                   AWREADY,
    input  wire [31:0]           WDATA,
    input  wire [3:0]            WSTRB,
    input  wire                  WVALID,
    output reg                   WREADY,
    output wire [1:0]            BRESP,
    output reg                   BVALID,
    input  wire                  BREADY
);

    assign RRESP = 2'b00;
    assign BRESP = 2'b00;

    reg        busy_reg;
    reg        done_reg;
    reg        start_pulse;
    reg [31:0] mat_a_reg [0:3];
    reg [31:0] mat_b_reg [0:3];
    wire [ACC_WIDTH-1:0] c_out [0:3][0:3];

    wire [7:0] aw_offset = AWADDR[7:0];

    // AXI Write Channel
    always @(posedge ACLK or negedge ARESETN) begin
        if (!ARESETN) begin
            AWREADY      <= 1'b0;
            WREADY       <= 1'b0;
            BVALID       <= 1'b0;
            start_pulse  <= 1'b0;
            mat_a_reg[0] <= 32'b0; mat_a_reg[1] <= 32'b0;
            mat_a_reg[2] <= 32'b0; mat_a_reg[3] <= 32'b0;
            mat_b_reg[0] <= 32'b0; mat_b_reg[1] <= 32'b0;
            mat_b_reg[2] <= 32'b0; mat_b_reg[3] <= 32'b0;
        end else begin
            start_pulse <= 1'b0; // Default 1-cycle trigger

            if (!AWREADY && AWVALID && WVALID) begin
                AWREADY <= 1'b1;
                WREADY  <= 1'b1;
            end else begin
                AWREADY <= 1'b0;
                WREADY  <= 1'b0;
            end

            if (AWREADY && WREADY && !BVALID) begin
                BVALID <= 1'b1;
                case (aw_offset)
                    8'h00: if (WDATA[0]) start_pulse <= 1'b1; // Direct trigger
                    8'h10: mat_a_reg[0] <= WDATA;
                    8'h14: mat_a_reg[1] <= WDATA;
                    8'h18: mat_a_reg[2] <= WDATA;
                    8'h1C: mat_a_reg[3] <= WDATA;
                    8'h20: mat_b_reg[0] <= WDATA;
                    8'h24: mat_b_reg[1] <= WDATA;
                    8'h28: mat_b_reg[2] <= WDATA;
                    8'h2C: mat_b_reg[3] <= WDATA;
                    default: ;
                endcase
            end else if (BVALID && BREADY) begin
                BVALID <= 1'b0;
            end
        end
    end

    // AXI Read Channel
    wire [7:0] ar_offset = ARADDR[7:0];
    always @(posedge ACLK or negedge ARESETN) begin
        if (!ARESETN) begin
            ARREADY <= 1'b0;
            RVALID  <= 1'b0;
            RDATA   <= 32'b0;
        end else begin
            if (!ARREADY && ARVALID) begin
                ARREADY <= 1'b1;
                RVALID  <= 1'b1;
                case (ar_offset)
                    8'h00: RDATA <= {31'b0, busy_reg};
                    8'h04: RDATA <= {30'b0, done_reg, busy_reg};
                    8'h10: RDATA <= mat_a_reg[0];
                    8'h14: RDATA <= mat_a_reg[1];
                    8'h18: RDATA <= mat_a_reg[2];
                    8'h1C: RDATA <= mat_a_reg[3];
                    8'h20: RDATA <= mat_b_reg[0];
                    8'h24: RDATA <= mat_b_reg[1];
                    8'h28: mat_b_reg[2] <= WDATA;
                    8'h2C: mat_b_reg[3] <= WDATA;
                    8'h40: RDATA <= c_out[0][0];
                    8'h44: RDATA <= c_out[0][1];
                    8'h48: RDATA <= c_out[0][2];
                    8'h4C: RDATA <= c_out[0][3];
                    8'h50: RDATA <= c_out[1][0];
                    8'h54: RDATA <= c_out[1][1];
                    8'h58: RDATA <= c_out[1][2];
                    8'h5C: RDATA <= c_out[1][3];
                    8'h60: RDATA <= c_out[2][0];
                    8'h64: RDATA <= c_out[2][1];
                    8'h68: RDATA <= c_out[2][2];
                    8'h6C: RDATA <= c_out[2][3];
                    8'h70: RDATA <= c_out[3][0];
                    8'h74: RDATA <= c_out[3][1];
                    8'h78: RDATA <= c_out[3][2];
                    8'h7C: RDATA <= c_out[3][3];
                    default: RDATA <= 32'hDEAD0000;
                endcase
            end else if (RVALID && RREADY) begin
                RVALID  <= 1'b0;
                ARREADY <= 1'b0;
            end
        end
    end

    // Execution FSM
    reg [4:0] step;
    reg       clr_pulse;

    always @(posedge ACLK or negedge ARESETN) begin
        if (!ARESETN) begin
            busy_reg  <= 1'b0;
            done_reg  <= 1'b0;
            step      <= 5'd0;
            clr_pulse <= 1'b0;
        end else begin
            if (start_pulse && !busy_reg) begin
                busy_reg  <= 1'b1;
                done_reg  <= 1'b0;
                step      <= 5'd0;
                clr_pulse <= 1'b1;
            end else if (busy_reg) begin
                clr_pulse <= 1'b0;
                step      <= step + 1'b1;
                if (step >= 5'd16) begin
                    busy_reg <= 1'b0;
                    done_reg <= 1'b1;
                end
            end
        end
    end

    function [7:0] get_a_elem(input integer r, input integer st);
        integer k;
        begin
            k = st - 1 - r;
            if (k == 0)      get_a_elem = mat_a_reg[r][7:0];
            else if (k == 1) get_a_elem = mat_a_reg[r][15:8];
            else if (k == 2) get_a_elem = mat_a_reg[r][23:16];
            else if (k == 3) get_a_elem = mat_a_reg[r][31:24];
            else             get_a_elem = 8'd0;
        end
    endfunction

    function [7:0] get_b_elem(input integer c, input integer st);
        integer k;
        begin
            k = st - 1 - c;
            if (k == 0)      get_b_elem = mat_b_reg[c][7:0];
            else if (k == 1) get_b_elem = mat_b_reg[c][15:8];
            else if (k == 2) get_b_elem = mat_b_reg[c][23:16];
            else if (k == 3) get_b_elem = mat_b_reg[c][31:24];
            else             get_b_elem = 8'd0;
        end
    endfunction

    wire [7:0] a_in_0 = (busy_reg && !clr_pulse) ? get_a_elem(0, step) : 8'd0;
    wire [7:0] a_in_1 = (busy_reg && !clr_pulse) ? get_a_elem(1, step) : 8'd0;
    wire [7:0] a_in_2 = (busy_reg && !clr_pulse) ? get_a_elem(2, step) : 8'd0;
    wire [7:0] a_in_3 = (busy_reg && !clr_pulse) ? get_a_elem(3, step) : 8'd0;

    wire [7:0] b_in_0 = (busy_reg && !clr_pulse) ? get_b_elem(0, step) : 8'd0;
    wire [7:0] b_in_1 = (busy_reg && !clr_pulse) ? get_b_elem(1, step) : 8'd0;
    wire [7:0] b_in_2 = (busy_reg && !clr_pulse) ? get_b_elem(2, step) : 8'd0;
    wire [7:0] b_in_3 = (busy_reg && !clr_pulse) ? get_b_elem(3, step) : 8'd0;

    systolic_array_4x4 #(
        .DATA_WIDTH(DATA_WIDTH),
        .ACC_WIDTH(ACC_WIDTH)
    ) array_inst (
        .clk     (ACLK),
        .rst_n   (ARESETN),
        .clr_acc (clr_pulse),
        .en      (busy_reg && !clr_pulse),
        .a_in_0  (a_in_0),
        .a_in_1  (a_in_1),
        .a_in_2  (a_in_2),
        .a_in_3  (a_in_3),
        .b_in_0  (b_in_0),
        .b_in_1  (b_in_1),
        .b_in_2  (b_in_2),
        .b_in_3  (b_in_3),
        .c_00(c_out[0][0]), .c_01(c_out[0][1]), .c_02(c_out[0][2]), .c_03(c_out[0][3]),
        .c_10(c_out[1][0]), .c_11(c_out[1][1]), .c_12(c_out[1][2]), .c_13(c_out[1][3]),
        .c_20(c_out[2][0]), .c_21(c_out[2][1]), .c_22(c_out[2][2]), .c_23(c_out[2][3]),
        .c_30(c_out[3][0]), .c_31(c_out[3][1]), .c_32(c_out[3][2]), .c_33(c_out[3][3])
    );

endmodule
