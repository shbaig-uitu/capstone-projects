module alu(
	input [31:0] a,
	input [31:0] b,
	input [2:0] funct3,
	input funct7_5,
	output reg [31:0] alu_result
);

always @(*) begin
case(funct3)
	3'b000: begin
		if(funct7_5) begin
		alu_result = a - b;
		end
		else begin
		alu_result = a + b;
		end
	end
	3'b001: alu_result = a << b[4:0];
	3'b010: alu_result = ($signed(a) < $signed(b)) ? 32'd1 : 32'd0;
	3'b011: alu_result = (a < b) ? 32'd1 : 32'd0;
	3'b100: alu_result = a ^ b;
	3'b101: begin
		if(funct7_5) begin
		alu_result = $signed(a) >>> b[4:0];
		end
		else begin
		alu_result = a >> b[4:0];
		end	
	end
	3'b110: alu_result = a | b;
	3'b111: alu_result = a & b;
	default: alu_result = 32'b0;
	endcase
end
endmodule
