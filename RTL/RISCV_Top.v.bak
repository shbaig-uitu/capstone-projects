module riscv_top (
    input  wire        clk,
    input  wire        reset,          // Active-low reset (0 = reset, 1 = run)
    input  wire        stall,          // AXI transaction ke waqt core freeze rahega
    
    // Instruction Memory Interface
    output wire [31:0] imem_addr,
    input  wire [31:0] imem_data,

    // Data Memory / Interconnect Interface
    output wire [31:0] mem_addr,
    output wire [31:0] mem_wdata,
    output wire        mem_read,
    output wire        mem_write,
    input  wire [31:0] mem_rdata
);

    // PC Wires
    wire [31:0] pc;
    wire [31:0] pc_plus_4;
    wire [31:0] pc_target;
    wire [31:0] next_pc;

    // Instruction Decode Wires
    wire [31:0] inst = imem_data;
    wire [6:0]  opcode   = inst[6:0];
    wire [2:0]  funct3   = inst[14:12];
    wire [6:0]  funct7   = inst[31:25];
    wire [4:0]  rs1      = inst[19:15];
    wire [4:0]  rs2      = inst[24:20];
    wire [4:0]  rd       = inst[11:7];

    // Control Signals
    wire        reg_write;
    wire        alu_src;
    wire [1:0]  mem_to_reg;
    wire        branch;
    wire        jump;
    wire        jump_reg;
    wire [1:0]  alu_op;
    wire [3:0]  alu_control;
    wire        branch_taken;

    // Datapath Wires
    wire [31:0] rs1_data;
    wire [31:0] rs2_data;
    wire [31:0] imm;
    wire [31:0] alu_operand_b;
    wire [31:0] alu_result;
    reg  [31:0] rd_write_data;

    // --- PC Logic ---
    assign pc_plus_4 = pc + 32'd4;
    assign pc_target = (jump_reg) ? (rs1_data + imm) : (pc + imm);
    assign next_pc   = (branch_taken || jump) ? pc_target : pc_plus_4;
    assign imem_addr = pc;

    program_counter pc_u (
        .clk     (clk),
        .reset   (reset),
        .stall   (stall),
        .next_pc (next_pc),
        .pc      (pc)
    );

    // --- Register File ---
    reg_file rf_u (
        .clk           (clk),
        .reset         (reset),
        .reg_write_en  (reg_write),
        .stall         (stall),
        .rs1           (rs1),
        .rs2           (rs2),
        .rd            (rd),
        .rd_write_data (rd_write_data),
        .rs1_data      (rs1_data),
        .rs2_data      (rs2_data)
    );

    // --- Immediate Generator ---
    imm_gen imm_gen_u (
        .inst    (inst),
        .imm_out (imm)
    );

    // --- Control Units ---
    control_unit cu_u (
        .opcode     (opcode),
        .reg_write  (reg_write),
        .alu_src    (alu_src),
        .mem_read   (mem_read),
        .mem_write  (mem_write),
        .mem_to_reg (mem_to_reg),
        .branch     (branch),
        .jump       (jump),
        .jump_reg   (jump_reg),
        .alu_op     (alu_op)
    );

    alu_decoder alu_dec_u (
        .alu_op      (alu_op),
        .funct3      (funct3),
        .funct7_5    (funct7[5]),
        .opcode      (opcode),
        .alu_control (alu_control)
    );

    branch_unit bu_u (
        .rs1_data     (rs1_data),
        .rs2_data     (rs2_data),
        .funct3       (funct3),
        .branch       (branch),
        .branch_taken (branch_taken)
    );

    // --- ALU Execution ---
    assign alu_operand_b = (alu_src) ? imm : rs2_data;

    alu alu_u (
        .a           (rs1_data),
        .b           (alu_operand_b),
        .alu_control (alu_control),
        .alu_result  (alu_result),
        .zero        ()
    );

    // --- External Data Memory / AXI Assignment ---
    assign mem_addr  = alu_result;
    assign mem_wdata = rs2_data;

    // --- Write-Back Mux (mem_to_reg) ---
    always @(*) begin
        case (mem_to_reg)
            2'b00:   rd_write_data = alu_result;
            2'b01:   rd_write_data = mem_rdata;
            2'b10:   rd_write_data = pc_plus_4;
            2'b11:   rd_write_data = imm;
            default: rd_write_data = alu_result;
        endcase
    end

endmodule
