`timescale 1ns / 1ps

module systolic_array_4x4 #(
    parameter DATA_WIDTH = 8,
    parameter ACC_WIDTH  = 32
)(
    input  wire                   clk,
    input  wire                   rst_n,
    input  wire                   clr_acc,
    input  wire                   en,

    // Matrix A Inputs (Left side feeds)
    input  wire [DATA_WIDTH-1:0]  a_in_0,
    input  wire [DATA_WIDTH-1:0]  a_in_1,
    input  wire [DATA_WIDTH-1:0]  a_in_2,
    input  wire [DATA_WIDTH-1:0]  a_in_3,

    // Matrix B Inputs (Top side feeds)
    input  wire [DATA_WIDTH-1:0]  b_in_0,
    input  wire [DATA_WIDTH-1:0]  b_in_1,
    input  wire [DATA_WIDTH-1:0]  b_in_2,
    input  wire [DATA_WIDTH-1:0]  b_in_3,

    // 16 Accumulator Outputs (Matrix C result)
    output wire [ACC_WIDTH-1:0]   c_00, c_01, c_02, c_03,
    output wire [ACC_WIDTH-1:0]   c_10, c_11, c_12, c_13,
    output wire [ACC_WIDTH-1:0]   c_20, c_21, c_22, c_23,
    output wire [ACC_WIDTH-1:0]   c_30, c_31, c_32, c_33
);

    // Horizontal wires (Matrix A forwarding: 4 rows x 5 stages)
    wire [DATA_WIDTH-1:0] a_wire [0:3][0:4];

    // Vertical wires (Matrix B forwarding: 5 stages x 4 columns)
    wire [DATA_WIDTH-1:0] b_wire [0:4][0:3];

    // Connect external boundary inputs
    assign a_wire[0][0] = a_in_0;
    assign a_wire[1][0] = a_in_1;
    assign a_wire[2][0] = a_in_2;
    assign a_wire[3][0] = a_in_3;

    assign b_wire[0][0] = b_in_0;
    assign b_wire[0][1] = b_in_1;
    assign b_wire[0][2] = b_in_2;
    assign b_wire[0][3] = b_in_3;

    // Accumulator wire array
    wire [ACC_WIDTH-1:0] acc_out_w [0:3][0:3];

    // Instantiate 4x4 PE Mesh
    genvar r, c;
    generate
        for (r = 0; r < 4; r = r + 1) begin : gen_row
            for (c = 0; c < 4; c = c + 1) begin : gen_col
                pe #(
                    .DATA_WIDTH(DATA_WIDTH),
                    .ACC_WIDTH(ACC_WIDTH)
                ) pe_inst (
                    .clk     (clk),
                    .rst_n   (rst_n),
                    .clr_acc (clr_acc),
                    .en      (en),
                    .a_in    (a_wire[r][c]),
                    .b_in    (b_wire[r][c]),
                    .a_out   (a_wire[r][c+1]),
                    .b_out   (b_wire[r+1][c]),
                    .acc_out (acc_out_w[r][c])
                );
            end
        end
    endgenerate

    // Output Mapping
    assign c_00 = acc_out_w[0][0];
    assign c_01 = acc_out_w[0][1];
    assign c_02 = acc_out_w[0][2];
    assign c_03 = acc_out_w[0][3];

    assign c_10 = acc_out_w[1][0];
    assign c_11 = acc_out_w[1][1];
    assign c_12 = acc_out_w[1][2];
    assign c_13 = acc_out_w[1][3];

    assign c_20 = acc_out_w[2][0];
    assign c_21 = acc_out_w[2][1];
    assign c_22 = acc_out_w[2][2];
    assign c_23 = acc_out_w[2][3];

    assign c_30 = acc_out_w[3][0];
    assign c_31 = acc_out_w[3][1];
    assign c_32 = acc_out_w[3][2];
    assign c_33 = acc_out_w[3][3];

endmodule
